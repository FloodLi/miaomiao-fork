# Keep logs readable during bring-up
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Code size: factory partition headroom is tight (~8.8%). Optimize for size (-Os)
# instead of the default debug level (-Og) to free flash for OTA growth.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Use custom partition table with SPIFFS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# OTA safety: boot the new app once in pending-verify state and roll back if it fails.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Flash size (your chip is 16MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ESP32-S3 boards used by this project usually include PSRAM. 5.83"/7.5"
# tricolor image conversion needs it because two EPD planes are too large
# for the remaining internal heap after Wi-Fi/Web startup.
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
# Allocations up to this size are forced into internal RAM. The default 16384
# trapped the 8KB msg_render task stack in internal RAM, which then failed with
# ESP_ERR_NO_MEM once internal memory fragmented (larger task stacks fell back
# to PSRAM and kept working). 4096 lets 8-24KB task stacks use the PSRAM
# fallback (CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y, ESP32-S3 supports it).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Enable SPIFFS (we mount /spiffs)
CONFIG_SPIFFS_MAX_PARTITIONS=2

# Crash diagnostics: keep panic/watchdog core dumps in the flash coredump
# partition. This is the ESP-IDF standard "system safety log" mechanism and is
# useful when field devices reboot after WDT/panic.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# CONFIG_ESP_COREDUMP_ENABLE_TO_UART is not set
# CONFIG_ESP_COREDUMP_ENABLE_TO_NONE is not set
CONFIG_ESP_COREDUMP_DATA_FORMAT_BIN=y
# CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF is not set
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# CONFIG_ESP_COREDUMP_CHECKSUM_SHA256 is not set
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=8
CONFIG_ESP_COREDUMP_USE_STACK_SIZE=y
CONFIG_ESP_COREDUMP_STACK_SIZE=2048

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# HTTPS (for weather API)
# Use the "common" root-CA subset instead of the FULL bundle to save ~30KB flash.
# QWeather's API host uses mainstream commercial CAs (DigiCert / GlobalSign /
# Let's Encrypt …) which are covered by CMN. If weather HTTPS ever fails to
# validate (boot log loses "esp-x509-crt-bundle: Certificate validated"),
# revert this single line back to ..._DEFAULT_FULL=y.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# ilinkai.weixin.qq.com (personal-WeChat ilink gateway) rejects TLS 1.2
# handshakes with a fatal alert; TLS 1.3 is required to reach it.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# TLS record buffers (IN16KB per connection) live in PSRAM instead of internal
# RAM: the WeChat endpoints keep several concurrent TLS sessions (wecom WS,
# ilinkai long-poll, httpd polling) and mbedtls_ssl_setup failed (-0x7F00)
# allocating ~20KB internal per connection. PSRAM is memory-mapped and fine
# for software encrypt/decrypt; internal RAM only keeps the small structs.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Trim mbedtls features the firmware never uses so TLS1.3 still fits the
# 3 MiB app partition (kept curves: SECP256R1 / SECP384R1 / CURVE25519).
# CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK is not set
# CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK_EPHEMERAL is not set
# CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE is not set
# CONFIG_MBEDTLS_PKCS7_C is not set
# CONFIG_MBEDTLS_PEM_WRITE_C is not set
# CONFIG_MBEDTLS_X509_CRL_PARSE_C is not set
# CONFIG_MBEDTLS_X509_CSR_PARSE_C is not set
# CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_RSA is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA is not set

# Weixin endpoints (work.weixin.qq.com / ilinkai.weixin.qq.com) serve a
# digicert.cn chain that esp_crt_bundle's single-candidate name match fails to
# verify (PK verify error 0x4290). The wecom/wechat clients therefore retry with
# verification disabled when the strict check fails; these two options only
# permit VERIFY_NONE when a connection provides NO CA at all (weather and other
# clients pass crt_bundle_attach and stay fully verified).
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# lwIP: STA+SoftAP + HTTPD + esp_http_client can hit pbuf ref asserts in tcp_input under load.
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
# Browser keep-alive + httpd listen + WebSocket + outbound TLS needs more than
# the default 10 sockets ("Failed to create socket" on bind API calls).
CONFIG_LWIP_MAX_SOCKETS=24
# TCPIP_CORE_LOCKING is off: on ESP32-S3 SMP it can destabilize the scheduler (Core 1 panic in prvSelectHighestPriorityTaskSMP).
# CONFIG_LWIP_TCPIP_CORE_LOCKING is not set
# CONFIG_LWIP_TCPIP_TASK_AFFINITY_NO_AFFINITY is not set
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Simpler TCP RX path (fewer tcp_seg/pbuf edges in tcp_free_acked_segments)
# CONFIG_LWIP_TCP_QUEUE_OOSEQ is not set
